# ============================================
# CDMS Backend Environment Configuration
# ============================================

# ------------------
# Vault Configuration
# ------------------
export VAULT_ADDR=http://127.0.0.1:8200
export VAULT_TOKEN=root


# ------------------
# API Configuration
# ------------------
PORT=3000
NODE_ENV=development

# ------------------
# Hyperledger Fabric Configuration
# ------------------
CHANNEL_NAME=mychannel
CONTRACT_NAME=cdmscontract

# ------------------
# File Storage Configuration
# ------------------
FILES_PATH=./files
WALLET_PATH=./wallet

# ------------------
# Logging Configuration
# ------------------
LOG_LEVEL=info

# ------------------
# Security Configuration (Optional for now)
# ------------------
# Uncomment these in production:
# JWT_SECRET=your-super-secret-key-change-this-in-production
# JWT_EXPIRY=1h
# ENABLE_RATE_LIMIT=true
# RATE_LIMIT_WINDOW=15
# RATE_LIMIT_MAX_REQUESTS=100

# ------------------
# MinIO Configuration (Future Integration)
# ------------------
# Uncomment when you integrate MinIO:
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=cdms-records
# MINIO_USE_SSL=false